{
  "manifest_version": 3,
  "name": "Claymore Piko",
  "version": "1.5.10",
  "description": "Claymore Piko 浏览器扩展：让你的 Piko 和其他支持 MCP 的 AI agent 操控你自己的 Chrome，带着全部登录态。",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Claymore Piko"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "offscreen",
    "downloads",
    "sidePanel",
    "notifications",
    "debugger",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "side_panel": {
    "default_path": "panel.html"
  }
}
